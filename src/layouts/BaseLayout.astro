---
// Archivo se carga con el eje de ancho (wdth) porque los titulares usan la
// variante expandida de verdad, no una simulación.
import '@fontsource-variable/archivo/wdth.css';
// Itálica de verdad para la firma del encabezado: sin esto el navegador la
// falsearía inclinando las letras rectas.
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#EDF1F7" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />
  </head>

  <body class="bg-ground font-sans text-ink antialiased">
    <a
      href="#inicio"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-ink focus:px-5 focus:py-3 focus:text-sm focus:text-ground"
    >
      Saltar al contenido
    </a>

    {/* Reglas de margen: dos filetes verticales que marcan la columna de
        contenido de arriba abajo. Son la textura general de la página —viven en
        los márgenes, nunca detrás del texto— y con los separadores horizontales
        arman la retícula de una hoja de dibujo técnico. */}
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-y-0 left-1/2 z-0 hidden w-[calc(100%-3rem)] max-w-[1180px] -translate-x-1/2 border-x border-ink/[0.08] sm:block sm:w-[calc(100%-4rem)]"
    >
    </div>

    <div class="relative z-10 min-h-screen overflow-x-hidden">
      <slot />
    </div>
  </body>
</html>
