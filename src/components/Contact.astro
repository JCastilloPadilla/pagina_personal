---
import { contactIntro, email } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section id="contacto">
  <div class="mx-auto max-w-[1180px] px-6 pt-24 pb-28 sm:px-8">
    <SectionHeading label="Contacto" index="04 / 04" />

    <div class="mt-12">
      <p class="max-w-[40ch] text-lg text-graphite">{contactIntro}</p>

      {/* Una sola acción principal, al tamaño que le corresponde. */}
      <a
        href={`mailto:${email}`}
        class="email-link mt-8 inline-block max-w-full break-words text-[clamp(28px,5.2vw,64px)] font-medium tracking-tight text-ink"
      >
        <span>{email}</span>
        <span class="rj45" aria-hidden="true"></span>
      </a>

      {/* Las redes no se repiten aquí: ya están en el riel del hero y en el
          pie. Esta sección se queda con una sola acción. */}
    </div>
  </div>
</section>

<style>
  .email-link {
    position: relative;
    padding-bottom: 18px;
    transition: color 180ms ease;
  }

  /* El subrayado se comporta como un cable que llega hasta el conector. */
  .email-link::after {
    content: '';
    position: absolute;
    right: 16px;
    bottom: 9px;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--color-link);
    scale: 0 1;
    transform-origin: left center;
    transition: scale 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rj45 {
    position: absolute;
    right: 0;
    bottom: 3px;
    width: 18px;
    height: 13px;
    border: 1.5px solid currentColor;
    border-radius: 2px 2px 4px 4px;
    color: var(--color-link);
    opacity: 0.42;
    translate: -6px 0;
    transition:
      opacity 180ms ease,
      translate 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Contactos del RJ45: retoman el naranja de las luces y de la paleta T568B. */
  .rj45::before {
    content: '';
    position: absolute;
    inset: 2px 3px auto;
    height: 3px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-alert) 0 1.5px,
      transparent 1.5px 3px
    );
  }

  .rj45::after {
    content: '';
    position: absolute;
    top: -5px;
    left: 5px;
    width: 6px;
    height: 5px;
    border: 1.5px solid currentColor;
    border-bottom: 0;
    border-radius: 2px 2px 0 0;
  }

  .email-link:hover,
  .email-link:focus-visible {
    color: var(--color-link);
  }

  .email-link:hover::after,
  .email-link:focus-visible::after {
    scale: 1 1;
  }

  .email-link:hover .rj45,
  .email-link:focus-visible .rj45 {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .email-link,
    .email-link::after,
    .rj45 {
      transition: none;
    }
  }
</style>
