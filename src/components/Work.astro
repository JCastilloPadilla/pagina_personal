---
import { work } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

{/* Lista, no tarjetas. Una lista dice "hay más de estos"; dos tarjetas
    grandes con un hueco para captura dicen "esto es todo lo que tengo". */}
<section id="trabajo" class="mx-auto max-w-[1180px] px-6 pt-24 pb-24 sm:px-8 lg:pt-32">
  <SectionHeading label="Más trabajo" index="03 / 04" />

  <ul>
    {
      work.map((item) => (
        <li>
          <div class="grid gap-x-12 gap-y-5 border-b border-ink/12 py-9 lg:grid-cols-[minmax(0,24ch)_minmax(0,1fr)_190px] lg:items-center">
            <h3 class="u-display text-[26px]">{item.title}</h3>

            <p class="max-w-[58ch] text-[15px] leading-[1.65] text-graphite">{item.summary}</p>

            <div class="flex items-start lg:items-center">
              <span class="u-label text-graphite lg:text-center">{item.meta}</span>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>
