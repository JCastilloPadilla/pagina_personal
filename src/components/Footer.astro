---
import { footerNote, origin, socials } from '../data/site';
import { SOCIAL_ICON_PATHS } from '../data/icons';
import FooterGarden from './FooterGarden.astro';
---

<footer class="mt-8">
  {/* Fila de datos, fuera del bloque y sobre el fondo del sitio. */}
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-6 pb-4 sm:px-8"
  >
    <p class="u-label text-graphite">{origin}</p>
    <p class="u-label text-graphite">{footerNote}</p>
  </div>

  <div class="mx-auto max-w-[1180px] px-6 sm:px-8">
    <div class="relative">
      {/* Las palmeras asoman sobre el borde del bloque, del mismo azul, como si
          crecieran de él. */}
      <div class="pointer-events-none absolute inset-x-0 bottom-full flex justify-center">
        <FooterGarden />
      </div>

      {/* Azul pleno arriba, disuelto en el fondo de la página abajo: por eso el
          nombre en blanco se apaga solo al bajar. Sin trama encima — el
          punteado va dentro de las letras, que es donde se ve bien. */}
      <div
        class="relative overflow-hidden rounded-t-[20px] bg-[linear-gradient(to_bottom,var(--color-link)_0%,var(--color-link)_26%,color-mix(in_srgb,var(--color-link)_62%,var(--color-ground))_52%,color-mix(in_srgb,var(--color-link)_22%,var(--color-ground))_78%,var(--color-ground)_100%)] px-6 pt-9 pb-6 sm:px-10"
      >
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                rel="me noopener"
                target="_blank"
                class="flex items-center gap-2.5 text-[15px] text-white/85 transition-colors hover:text-white"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-4">
                  {SOCIAL_ICON_PATHS[social.kind.toLowerCase()].map((d) => (
                    <path d={d} />
                  ))}
                </svg>
                {social.kind}
              </a>
            ))
          }

          <a
            href="#inicio"
            class="flex items-center gap-2 text-[15px] text-white/85 transition-colors hover:text-white sm:ml-auto"
          >
            <span aria-hidden="true">↑</span> Volver arriba
          </a>
        </div>

        {/* El nombre va en SVG y no en un <p>: así el trazo se escala al ancho
            del bloque en cualquier pantalla y siempre cae en una sola línea. Con
            texto normal se partía en tres líneas, porque a 158 px pedía 1805 px
            y solo hay 1036. */}
        <svg
          viewBox="0 0 1200 130"
          role="img"
          aria-label="Jose Carlos Castillo"
          class="mt-10 mb-4 w-full [mask-image:linear-gradient(to_bottom,#000_38%,transparent_94%)] select-none"
        >
          <defs>
            {/* Trama de medio tono dentro de las letras: la diferencia entre
                punto y fondo es de 0.09 de opacidad, lo justo para que se
                intuya el grano sin ensuciar el degradado. */}
            <pattern id="ft-halftone" width="4" height="4" patternUnits="userSpaceOnUse">
              <rect width="4" height="4" fill="#ffffff" fill-opacity="0.68" />
              <circle cx="2" cy="2" r="1" fill="#ffffff" fill-opacity="0.28" />
            </pattern>
          </defs>

          <text
            x="600"
            y="104"
            text-anchor="middle"
            textLength="1200"
            lengthAdjust="spacing"
            font-size="105"
            fill="url(#ft-halftone) #ffffff"
            class="u-display [font-stretch:125%]"
          >
            Jose Carlos Castillo
          </text>
        </svg>

        {/* Dos entradas discretas: el rombo abre el minijuego, el punto
            (triple clic) el acceso privado. */}
        <div class="flex items-center justify-end gap-5">
          <button
            type="button"
            data-open-game
            aria-label="Abrir minijuego Packet Catch"
            class="size-2 rotate-45 cursor-pointer bg-up opacity-60 transition hover:bg-alert hover:opacity-100"
          ></button>

          <button
            type="button"
            data-lock-tap
            aria-label="Acceso privado (tres clics)"
            class="cursor-default font-mono text-sm leading-none text-ink/25 transition-colors select-none hover:text-ink/50"
          >
            ·
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>
