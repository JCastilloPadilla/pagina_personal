---
import { nav, site } from '../data/site';
---

{/* Sin barra: las piezas flotan sobre el fondo. El contenedor no pinta nada y
    deja pasar los clics; solo las piezas son sensibles.

    El velo va en cada cajita, no en una barra. Sobre el fondo plano del sitio
    es del mismo color que la página, así que se ven flotando; sobre el shader
    del hero y sobre la banda oscura de FlowTrix se recortan solas y mantienen
    el texto legible (8.3:1 en el peor caso). */}
<header
  class="pointer-events-none fixed inset-x-0 top-0 z-40 flex items-center justify-between gap-2 px-4 py-4 sm:gap-4 sm:px-8"
>
  {/* La firma va suelta, sin caja. Como no tiene velo propio, el halo del color
      del fondo la rescata sobre la banda oscura: en claro es invisible, en
      oscuro recorta las letras sin dibujar un rectángulo. */}
  <a
    href="#inicio"
    class="pointer-events-auto shrink-0 font-display text-[16px] text-ink italic [text-shadow:0_0_10px_rgba(237,241,247,0.95),0_0_22px_rgba(237,241,247,0.75)] transition-opacity duration-200 hover:opacity-70"
  >
    <span class="sm:hidden">JC</span>
    <span class="hidden sm:inline">{site.shortName}</span>
  </a>

  <nav aria-label="Navegación principal" class="pointer-events-auto flex-1 min-w-0">
    {/* En móvil las cuatro opciones son compactas y comparten el ancho disponible:
        no hay scroll lateral ni enlaces ocultos. A partir de sm recuperan el
        espaciado y el ensanche al hover de la composición de escritorio. */}
    <ul
      class="flex w-full items-center justify-between gap-1 sm:w-auto sm:justify-end sm:gap-1.5"
    >
      {
        nav.map((item) => (
          <li class="min-w-0">
            {/* El hover ensancha la cajita en vez de escalarla: crecen a la vez
                el relleno lateral y la separación de los corchetes, así que la
                caja se estira y empuja a sus vecinas de la izquierda. Como la
                lista está anclada a la derecha, el crecimiento va hacia allá. */}
            <a
              href={item.href}
              class="group flex shrink-0 items-center justify-center gap-1 bg-ground/70 px-1.5 py-1.5 font-mono text-[11px] whitespace-nowrap text-ink backdrop-blur-md transition-[gap,padding] duration-300 ease-out sm:gap-1.5 sm:px-2.5 sm:text-[13px] sm:hover:gap-3 sm:hover:px-4"
            >
              <span class="text-ink/35 transition-colors group-hover:text-link">[</span>
              {item.label}
              <span class="text-ink/35 transition-colors group-hover:text-link">]</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
