---
interface Props {
  tone: 'silver' | 'bronze';
}

const { tone } = Astro.props;

/**
 * El punto que separa el metal del certamen hace de gancho: de él cuelga la
 * medalla.
 *
 * Colgar del punto y no de la palabra resuelve el problema anterior — un cordón
 * que abrazaba «Plata» o «Bronce» tenía que estirarse a anchos distintos y nunca
 * caía natural. El punto siempre mide lo mismo, así que el cordón cae recto.
 *
 * Todo va fuera del flujo: la línea de texto no se mueve ni un píxel.
 */

/** Los degradados se referencian por id, y cada premio se pinta dos veces:
 *  una para escritorio y otra para móvil. */
const uid = Math.random().toString(36).slice(2, 8);
const gradientId = `medal-${tone}-${uid}`;

const CORD = {
  silver: '#1e9d57',
  bronze: '#c0392b',
} as const;

const PLATE = {
  silver: { light: '#F1F3F5', mid: '#AEB4BC', shine: '#DDE1E6', dark: '#767C85', edge: '#565C64' },
  bronze: { light: '#EFC085', mid: '#BC7C39', shine: '#DFA463', dark: '#8A5720', edge: '#6B4316' },
} as const;

const plate = PLATE[tone];
---

{/* El separador conserva el ancho de un carácter para no alterar la posición
    de ninguna palabra. El punto y la cinta comparten el mismo eje. */}<span
  class="medal-hook"
  aria-hidden="true"
><span class="marker"></span><span class="hanger">
    <svg viewBox="0 0 16 64" aria-hidden="true" class="medal">
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color={plate.light} />
          <stop offset="34%" stop-color={plate.mid} />
          <stop offset="50%" stop-color={plate.shine} />
          <stop offset="72%" stop-color={plate.mid} />
          <stop offset="100%" stop-color={plate.dark} />
        </linearGradient>
      </defs>

      {/* Una cinta plana y ligeramente más ancha mantiene la solución mínima.
          Su extremo entra detrás de la placa para que no necesite herrajes. */}
      <path
        d="M8 0V35"
        fill="none"
        stroke={CORD[tone]}
        stroke-width="2.5"
        stroke-linecap="round"
      />

      {/* Placa rectangular vertical. */}
      <rect
        x="1.5"
        y="33.5"
        width="13"
        height="29"
        rx="2"
        fill={`url(#${gradientId})`}
        stroke={plate.edge}
        stroke-width="0.7"
      />

      {/* Bisel interior: le da grosor a la placa. */}
      <rect
        x="3.7"
        y="35.7"
        width="8.6"
        height="24.6"
        rx="1"
        fill="none"
        stroke={plate.edge}
        stroke-opacity="0.4"
        stroke-width="0.6"
      />
    </svg></span></span>

<style>
  .medal-hook {
    position: relative;
    display: inline-block;
    width: 1ch;
    height: 1em;
    vertical-align: -0.08em;
  }

  /* Tachuela vista de frente: su cabeza presiona la cinta contra el fondo. */
  .marker {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border: 1px solid #4b5565;
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 30%,
      #ffffff 0 10%,
      #cbd1da 24%,
      #737e90 58%,
      #2f394b 100%
    );
    box-shadow:
      0 1px 2px rgb(13 21 38 / 32%),
      0 0 0 1px rgb(255 255 255 / 45%);
    translate: -50% -50%;
  }

  /* Pequeño reflejo central que permite reconocer la cabeza a escala reducida. */
  .marker::after {
    content: '';
    position: absolute;
    top: 1px;
    left: 1px;
    width: 1.5px;
    height: 1.5px;
    border-radius: 50%;
    background: rgb(255 255 255 / 78%);
  }

  /* Fuera del flujo: la medalla cuelga sin desplazar el texto. */
  .hanger {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% 0;
    line-height: 0;
  }

  .medal {
    display: block;
    height: 54px;
    width: auto;
    transform-box: fill-box;
    will-change: transform;
    /* Pivota en el punto, que es de donde cuelga. */
    transform-origin: top center;
  }

  /* La clase permanece hasta `animationend`, aunque el cursor ya haya salido. */
  .medal.is-swinging {
    animation: medal-swing 1.8s cubic-bezier(0.25, 0.6, 0.3, 1);
  }

  /* Péndulo amortiguado: cada vaivén más corto que el anterior. */
  @keyframes medal-swing {
    0% {
      transform: rotate(0deg);
    }
    18% {
      transform: rotate(12deg);
    }
    40% {
      transform: rotate(-7.5deg);
    }
    60% {
      transform: rotate(4deg);
    }
    78% {
      transform: rotate(-1.8deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .medal.is-swinging {
      animation: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.award-line').forEach((award) => {
    const medal = award.querySelector<HTMLElement>('.medal');
    if (!medal) return;

    award.addEventListener('pointerenter', () => {
      if (reducedMotion.matches) return;

      /* Reinicia el gesto si el cursor vuelve a pasar antes de que termine. */
      medal.classList.remove('is-swinging');
      void medal.offsetWidth;
      medal.classList.add('is-swinging');
    });

    medal.addEventListener('animationend', () => {
      medal.classList.remove('is-swinging');
    });
  });
</script>
