---
import { profile } from '../data/site';
---

{/* Capas del hero, de atrás hacia adelante:
    -z-30  ilustración editorial estática
    -z-10  velos que calman el fondo bajo el texto
     auto  contenido */}
<section id="inicio" class="relative isolate flex flex-col sm:min-h-[88vh]">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-30 overflow-hidden">
    <img
      src="/images/hero-watercolor-city.png"
      alt=""
      width="1672"
      height="941"
      fetchpriority="high"
      class="h-full w-full object-cover object-[48%_center] sm:object-center"
    />
  </div>

  {/* Velo lateral: conserva la zona de lectura del titular sobre la ilustración. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(100deg,color-mix(in_srgb,var(--color-ground)_28%,transparent)_0%,color-mix(in_srgb,var(--color-ground)_16%,transparent)_48%,transparent_78%)]"
  >
  </div>

  {/* Fundido inferior: el hero entra en el resto de la página sin costura. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-[linear-gradient(to_bottom,transparent,var(--color-ground))]"
  >
  </div>

  {/* En móvil fluye desde arriba para que la franja de estado no quede cortada.
      Desde sm recupera el centrado vertical de la composición amplia. */}
  <div
    class="mx-auto flex w-full max-w-[1180px] flex-col px-6 pt-28 pb-12 sm:flex-1 sm:justify-center sm:pt-32 sm:pb-20 sm:px-8"
  >
    {/* Tinta oscura sobre el cielo claro de la acuarela. */}
    <p class="u-rise u-label text-ink/80" style="animation-delay: 60ms">
      {profile.place}
    </p>

    <h1
      class="u-rise u-display mt-6 text-[clamp(46px,8.5vw,116px)]"
      style="animation-delay: 140ms"
    >
      Jose Carlos<br />Castillo Padilla
    </h1>

    <p
      class="u-rise mt-8 max-w-[44ch] text-lg leading-relaxed text-ink/80 sm:text-xl"
      style="animation-delay: 240ms"
    >
      {profile.tagline}
    </p>

    <div class="u-rise mt-10 flex flex-wrap items-center gap-3" style="animation-delay: 320ms">
      <a href="#proyectos" class="u-btn u-btn-solid">
        Ver proyectos
        <span aria-hidden="true">→</span>
      </a>
      <a href="#contacto" class="u-btn u-btn-line">Escríbeme</a>
    </div>
  </div>

  {/* Franja de estado, como la barra inferior de un panel de monitoreo. */}
  <div class="u-rise border-t border-ink/12" style="animation-delay: 420ms">
    <div
      class="mx-auto grid w-full max-w-[1180px] gap-2 px-6 py-4 sm:flex sm:flex-wrap sm:items-center sm:gap-x-8 sm:gap-y-2 sm:px-8"
    >
      <p class="u-label flex items-center gap-2.5 text-ink">
        <span class="u-dot" aria-hidden="true"></span>
        Último año de Ingeniería en Sistemas
      </p>
      <p class="u-label text-ink/80">Redes · Sistemas · Seguridad</p>
      <p class="u-label text-ink/80 sm:ml-auto">Abierto a prácticas</p>
    </div>
  </div>
</section>
