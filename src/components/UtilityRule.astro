---
/**
 * Separador exclusivo de FlowTrix.
 *
 * Los postes crecen hacia el espacio vacío de la sección anterior, de modo que
 * la escena no añade altura ni desplaza el contenido que viene después.
 */
const POLES = Array.from({ length: 6 });
const SPANS = Array.from({ length: POLES.length - 1 });
---

<div aria-hidden="true" class="utility-rule">
  <div class="utility-scene">
    {
      SPANS.map((_, index) => (
        <span class="wire wire-upper" style={`--segment: ${index}`}></span>
      ))
    }
    {
      SPANS.map((_, index) => (
        <span class="wire wire-lower" style={`--segment: ${index}`}></span>
      ))
    }

    {
      POLES.map((_, index) => (
        <span class="pole" style={`--position: ${index}`}>
          <span class="crossbar"></span>
          <span class="lamp-arm">
            <span class="lamp"></span>
          </span>
        </span>
      ))
    }

    <span class="grid-cross grid-cross-left"></span>
    <span class="grid-cross grid-cross-right"></span>
  </div>
</div>

<style>
  .utility-rule {
    position: relative;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .utility-scene {
    --lamp-color: #f2c94c;
    position: absolute;
    inset-inline: 1.5rem;
    bottom: 0;
    height: 68px;
    max-width: 1180px;
    margin-inline: auto;
    color: var(--color-graphite);
    pointer-events: none;
  }

  .pole {
    --pole-height: 58px;
    position: absolute;
    z-index: 2;
    bottom: 0;
    left: calc(var(--position) * 20%);
    width: 2px;
    height: var(--pole-height);
    background: currentColor;
    box-shadow: 1px 0 rgb(255 255 255 / 55%);
    opacity: 0.72;
    translate: -50% 0;
    pointer-events: auto;
  }

  .crossbar {
    position: absolute;
    top: 5px;
    left: 50%;
    width: 18px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    translate: -50% 0;
  }

  .crossbar::before,
  .crossbar::after {
    content: '';
    position: absolute;
    top: -2px;
    width: 2px;
    height: 3px;
    border-radius: 1px 1px 0 0;
    background: currentColor;
  }

  .crossbar::before {
    left: 2px;
  }

  .crossbar::after {
    right: 2px;
  }

  .lamp-arm {
    position: absolute;
    top: 14px;
    left: 1px;
    width: 13px;
    height: 8px;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    border-radius: 0 5px 0 0;
  }

  .pole:nth-of-type(even) .lamp-arm {
    right: 1px;
    left: auto;
    scale: -1 1;
    transform-origin: center;
  }

  .lamp {
    position: absolute;
    right: -3px;
    bottom: -2px;
    width: 6px;
    height: 3px;
    border-radius: 1px 1px 3px 3px;
    background: color-mix(in srgb, var(--lamp-color) 34%, var(--color-graphite));
    opacity: 1;
    transition:
      background-color 320ms ease,
      box-shadow 320ms ease;
  }

  /* El haz nace estrecho en el foco y se abre hasta tocar la línea base. */
  .lamp::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 38px;
    height: calc(var(--pole-height) - 24px);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--lamp-color) 42%, transparent),
      color-mix(in srgb, var(--lamp-color) 14%, transparent) 72%,
      color-mix(in srgb, var(--lamp-color) 25%, transparent)
    );
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    opacity: 0;
    translate: -50% 0;
    transition: opacity 360ms ease;
    pointer-events: none;
  }

  /* Un reflejo horizontal remata el cono exactamente sobre el suelo. */
  .lamp::before {
    content: '';
    position: absolute;
    top: calc(var(--pole-height) - 23px);
    left: 50%;
    width: 40px;
    height: 3px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--lamp-color) 58%, transparent);
    filter: blur(1.5px);
    opacity: 0;
    translate: -50% 0;
    transition: opacity 360ms ease;
    pointer-events: none;
  }

  .pole:hover .lamp,
  .lamp.is-lit {
    background: var(--lamp-color);
    opacity: 1;
    box-shadow:
      0 2px 5px color-mix(in srgb, var(--lamp-color) 62%, transparent),
      0 4px 10px color-mix(in srgb, var(--lamp-color) 32%, transparent);
  }

  .pole:hover .lamp::before,
  .pole:hover .lamp::after,
  .lamp.is-lit::before,
  .lamp.is-lit::after {
    opacity: 1;
  }

  /* Cada borde inferior redondeado forma una catenaria ligera entre postes. */
  .wire {
    position: absolute;
    z-index: 1;
    left: calc(var(--segment) * 20%);
    width: 20%;
    border-right: 1px solid transparent;
    border-bottom: 1px solid currentColor;
    border-left: 1px solid transparent;
    border-radius: 0 0 50% 50%;
    opacity: 0.46;
  }

  .wire-upper {
    bottom: 43px;
    height: 12px;
  }

  .wire-lower {
    bottom: 36px;
    height: 16px;
  }

  .grid-cross {
    position: absolute;
    bottom: 0;
    width: 9px;
    height: 9px;
    translate: -50% 50%;
  }

  .grid-cross::before,
  .grid-cross::after {
    content: '';
    position: absolute;
    background: color-mix(in srgb, var(--color-ink) 30%, transparent);
  }

  .grid-cross::before {
    top: 4px;
    left: 0;
    width: 9px;
    height: 1px;
  }

  .grid-cross::after {
    top: 0;
    left: 4px;
    width: 1px;
    height: 9px;
  }

  .grid-cross-left {
    left: 0;
  }

  .grid-cross-right {
    left: 100%;
  }

  @media (min-width: 640px) {
    .utility-scene {
      inset-inline: 2rem;
      height: 82px;
    }

    .pole {
      --pole-height: 70px;
    }

    .crossbar {
      width: 22px;
    }

    .lamp-arm {
      width: 16px;
    }

    .lamp::after {
      width: 48px;
    }

    .lamp::before {
      width: 50px;
    }

    .wire-upper {
      bottom: 54px;
      height: 14px;
    }

    .wire-lower {
      bottom: 46px;
      height: 19px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lamp,
    .lamp::before,
    .lamp::after {
      transition: none;
    }
  }
</style>

<script>
  const scene = document.querySelector<HTMLElement>('.utility-scene');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (scene) {
    const lamps = Array.from(scene.querySelectorAll<HTMLElement>('.lamp'));
    const timers = new Map<HTMLElement, number>();

    const stopLights = () => {
      timers.forEach((timer) => window.clearTimeout(timer));
      timers.clear();
      lamps.forEach((lamp) => lamp.classList.remove('is-lit'));
    };

    const scheduleLight = (lamp: HTMLElement) => {
      const delay = 900 + Math.random() * 2300;
      const timer = window.setTimeout(() => {
        lamp.classList.toggle('is-lit');
        scheduleLight(lamp);
      }, delay);

      timers.set(lamp, timer);
    };

    const startLights = () => {
      if (reducedMotion.matches || timers.size > 0) return;

      lamps.forEach((lamp, index) => {
        const timer = window.setTimeout(
          () => {
            lamp.classList.toggle('is-lit', Math.random() > 0.45);
            scheduleLight(lamp);
          },
          180 + index * 110 + Math.random() * 500,
        );

        timers.set(lamp, timer);
      });
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) {
          startLights();
        } else {
          stopLights();
        }
      },
      { threshold: 0.2 },
    );

    observer.observe(scene);
    reducedMotion.addEventListener('change', () => {
      stopLights();
      if (!reducedMotion.matches) startLights();
    });
  }
</script>
