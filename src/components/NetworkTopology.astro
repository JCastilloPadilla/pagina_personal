    color: var(--color-up);
  }

  .topology-status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
  }

  .topology-foot {
    bottom: 13px;
    justify-content: flex-start;
    gap: 18px;
    padding-top: 10px;
    border-top: 1px solid rgb(13 21 38 / 10%);
  }

  .topology-field {
    position: absolute;
    inset: 43px 0 37px;
  }

  .link {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    height: 1px;
    transform-origin: left center;
    background: linear-gradient(90deg, rgb(47 107 255 / 65%), rgb(13 21 38 / 18%));
    transition: background-color 240ms ease;
  }

  .link::before {
    position: absolute;
    inset: -3px 0;
    content: '';
    border-top: 1px dashed rgb(47 107 255 / 17%);
  }

  .link-a {
    width: 43%;
    transform: rotate(-146deg);
  }

  .link-b {
    width: 41%;
    transform: rotate(-34deg);
  }

  .link-c {
    width: 42%;
    transform: rotate(146deg);
