    background:
      linear-gradient(color-mix(in srgb, var(--color-link) 5%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-link) 5%, transparent) 1px, transparent 1px),
      color-mix(in srgb, var(--color-panel) 58%, transparent);
    background-size: 28px 28px;
    box-shadow: 0 18px 45px rgb(13 24 42 / 7%);
    transition:
      transform 350ms ease,
      border-color 350ms ease,
      box-shadow 350ms ease;
  }

  .network-topology:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-link) 35%, transparent);
    box-shadow: 0 22px 55px rgb(13 24 42 / 11%);
  }

  .topology-head,
  .topology-foot {
    position: absolute;
    z-index: 8;
    right: 16px;
    left: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
