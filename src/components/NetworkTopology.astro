<div
  class="network-topology"
  data-network-topology
  role="img"
  aria-label="Topología de FlowTrix: cuatro equipos envían telemetría al monitor central"
>
  <div class="topology-head" aria-hidden="true">
    <span>TOPOLOGY / LIVE</span>
    <span class="topology-status"><i></i> ONLINE</span>
  </div>

  <div class="topology-field" aria-hidden="true">
    <div class="link link-a"><i class="packet packet-a"></i></div>
    <div class="link link-b"><i class="packet packet-b"></i></div>
    <div class="link link-c"><i class="packet packet-c"></i></div>
    <div class="link link-d"><i class="packet packet-d"></i></div>

    <div class="device device-a">
      <span class="device-icon"><i></i><i></i></span>
      <span class="device-name">EQUIPO 01</span>
      <span class="device-state">EN LÍNEA</span>
    </div>

    <div class="device device-b">
      <span class="device-icon"><i></i><i></i></span>
      <span class="device-name">EQUIPO 02</span>
      <span class="device-state">EN LÍNEA</span>
    </div>

    <div class="device device-c">
      <span class="device-icon"><i></i><i></i></span>
      <span class="device-name">EQUIPO 03</span>
      <span class="device-state">EN LÍNEA</span>
    </div>

    <div class="device device-d">
      <span class="device-icon"><i></i><i></i></span>
      <span class="device-name">EQUIPO 04</span>
      <span class="device-state">EN LÍNEA</span>
    </div>

    <div class="core">
      <i class="core-ring ring-one"></i>
      <i class="core-ring ring-two"></i>
      <strong>FlowTrix</strong>
      <small>MONITOR</small>
    </div>

    <div class="alert-flag">
      <i></i>
      <span>ALERT / PORT 5433</span>
    </div>
  </div>

  <div class="topology-foot" aria-hidden="true">
    <span>4 EQUIPOS</span>
    <span>32 PKT/S</span>
    <span>LATENCY 18MS</span>
  </div>
</div>

<script>
  const topologies = document.querySelectorAll<HTMLElement>('[data-network-topology]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('is-active', entry.isIntersecting);
      });
    },
    { threshold: 0.35 },
  );

  topologies.forEach((topology) => observer.observe(topology));
</script>

<style>
  .network-topology {
