---
interface Props {
  /** Etiqueta de la sección. Va en mono, versalitas: es un dato, no un titular. */
  label: string;
  /** Tono para la banda oscura de FlowTrix. */
  tone?: 'light' | 'dark';
  id?: string;
}

const { label, tone = 'light', id } = Astro.props;
---

<div
  class:list={[
    'flex items-center gap-6 border-b pb-3',
    tone === 'dark' ? 'border-white/20' : 'border-ink/12',
  ]}
>
  <h2 id={id} class:list={['u-label', tone === 'dark' ? 'text-white/70' : 'text-graphite']}>
    {label}
  </h2>

  {/* Ranura para metadatos alineados a la derecha del filete. */}
  <div class="ml-auto flex items-center gap-5"><slot name="meta" /></div>
</div>
