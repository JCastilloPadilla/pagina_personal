---
interface Props {
  /** Etiqueta de la sección. Va en mono, versalitas: es un dato, no un titular. */
  label: string;
  /** Tono para la banda oscura de FlowTrix. */
  tone?: 'light' | 'dark';
  id?: string;
  /** Posición de la sección dentro del recorrido principal. */
  index?: string;
}

const { label, tone = 'light', id, index } = Astro.props;
---

<div
  class:list={[
    'relative flex items-center gap-6 border-b pb-3',
    tone === 'dark' ? 'border-white/20' : 'border-ink/12',
  ]}
>
  <h2 id={id} class:list={['u-label', tone === 'dark' ? 'text-white/70' : 'text-graphite']}>
    {label}
  </h2>

  {/* Ranura para metadatos alineados a la derecha del filete. */}
  <div class="ml-auto flex items-center gap-5"><slot name="meta" /></div>

  {
    index && (
      <span
        aria-hidden="true"
        class:list={[
          'section-index u-label',
          tone === 'dark' ? 'bg-night text-white/55' : 'bg-ground text-graphite/65',
        ]}
      >
        <span class="section-cross"></span>
        {index}
      </span>
    )
  }
</div>

<style>
  /* El código se posa sobre el inicio del filete como una coordenada técnica. */
  .section-index {
    position: absolute;
    bottom: 0;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-right: 8px;
    font-size: 9px;
    letter-spacing: 0.12em;
    translate: 0 50%;
  }

  .section-cross {
    position: relative;
    width: 9px;
    height: 9px;
    flex: none;
  }

  .section-cross::before,
  .section-cross::after {
    content: '';
    position: absolute;
    background: currentColor;
  }

  .section-cross::before {
    top: 4px;
    left: 0;
    width: 9px;
    height: 1px;
  }

  .section-cross::after {
    top: 0;
    left: 4px;
    width: 1px;
    height: 9px;
  }
</style>
