---
import { PALM_ARTWORK } from '../data/palms';

/**
 * Palmeras: la fila que asoma sobre el bloque del pie.
 *
 * Este componente coloca, espeja y anima. El dibujo vive en
 * `src/data/palms.ts`; una ráfaga recorre la fila al entrar en pantalla y cada
 * palmera conserva después su respuesta individual al cursor.
 */

interface Instance {
  /** Índice dentro de PALM_ARTWORK. */
  art: number;
  x: number;
  scale: number;
  flip: boolean;
  /** Grados que se inclina al pasar el cursor. */
  tilt: number;
}

/** El espejo duplica la variedad aparente sin costar un solo byte extra. */
const PALMS: Instance[] = [
  { art: 2, x: 26, scale: 0.3, flip: false, tilt: -7 },
  { art: 1, x: 80, scale: 0.32, flip: true, tilt: 6 },
  { art: 0, x: 132, scale: 0.26, flip: false, tilt: -8 },
  { art: 1, x: 188, scale: 0.4, flip: false, tilt: 7 },
  { art: 2, x: 246, scale: 0.35, flip: true, tilt: -6 },
  { art: 0, x: 300, scale: 0.42, flip: false, tilt: 8 },
  { art: 2, x: 352, scale: 0.27, flip: true, tilt: -7 },
  { art: 1, x: 404, scale: 0.33, flip: false, tilt: 6 },
];

const BASELINE = 112;
/** Ajustado a la extensión real de las palmeras: si sobra lienzo a un lado,
 *  la fila deja de verse centrada bajo el bloque. */
const VIEW_WIDTH = 438;
---

<svg
  viewBox={`0 0 ${VIEW_WIDTH} ${BASELINE}`}
  role="presentation"
  data-footer-garden
  class="pointer-events-none h-16 w-auto text-link sm:h-20 lg:h-24"
>
  <defs>
    {
      PALM_ARTWORK.map((art) => (
        <g id={art.id} fill="currentColor">
          {art.paths.map((d) => (
            <path d={d} />
          ))}
          {art.circles.map((c) => (
            <circle cx={c.cx} cy={c.cy} r={c.r} />
          ))}
        </g>
      ))
    }
  </defs>

  {
    PALMS.map((palm, index) => {
      const art = PALM_ARTWORK[palm.art];
      const wind = palm.flip ? -6 : 6;

      return (
        <g
          transform={`translate(${palm.x} ${BASELINE}) scale(${palm.flip ? -palm.scale : palm.scale} ${palm.scale})`}
        >
          {/* El grupo interno es el que rota: el `transform` del padre coloca y
              escala, y una transformación de CSS lo reemplazaría en vez de
              sumarse. */}
          <g
            class="palm"
            style={`--tilt: ${palm.tilt}deg; --wind: ${wind}deg; --wind-back: ${-wind * 0.36}deg; --wind-settle: ${wind * 0.14}deg; --wind-delay: ${index * 95}ms`}
          >
            {/* Zona sensible al cursor. Sin ella, apuntar a una hoja fina sería
                casi imposible. */}
            <rect
              x={-art.halfWidth}
              y={-art.height}
              width={art.halfWidth * 2}
              height={art.height}
              fill="transparent"
            />

            <use href={`#${art.id}`} />
          </g>
        </g>
      );
    })
  }
</svg>

<style>
  svg {
    overflow: visible;
  }

  .palm {
    pointer-events: auto;
    transform-box: fill-box;
    transform-origin: bottom center;
    /* Rebote corto al soltar: se mece, no gira sobre una bisagra. */
    transition: transform 620ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .palm:hover {
    transform: rotate(var(--tilt));
  }

  svg.is-windy .palm {
    animation: palm-gust 1.25s cubic-bezier(0.22, 0.72, 0.28, 1) var(--wind-delay) 1;
  }

  @keyframes palm-gust {
    0% {
      transform: rotate(0deg);
    }
    35% {
      transform: rotate(var(--wind));
    }
    60% {
      transform: rotate(var(--wind-back));
    }
    80% {
      transform: rotate(var(--wind-settle));
    }
    100% {
      transform: rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg.is-windy .palm {
      animation: none;
    }
  }
</style>

<script>
  const garden = document.querySelector<SVGElement>('[data-footer-garden]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (garden) {
    let isInView = false;
    const palms = garden.querySelectorAll('.palm');
    const lastPalm = palms.item(palms.length - 1);

    const playWind = () => {
      if (reducedMotion.matches) return;
      garden.classList.remove('is-windy');
      void garden.getBoundingClientRect();
      garden.classList.add('is-windy');
    };

    lastPalm?.addEventListener('animationend', () => {
      garden.classList.remove('is-windy');
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting && !isInView) {
          isInView = true;
          playWind();
        } else if (!entry?.isIntersecting) {
          isInView = false;
          garden.classList.remove('is-windy');
        }
      },
      { threshold: 0.3 },
    );

    observer.observe(garden);
  }
</script>
