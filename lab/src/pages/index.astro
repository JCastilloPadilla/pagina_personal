---
import '@fontsource-variable/ibm-plex-sans';
import { Image } from 'astro:assets';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../../../src/styles/global.css';
import '../styles/lab.css';
import workshop from '../assets/hero-workshop-cloud-edge-v4.png';
import footerCoast from '../assets/footer-coast-cloud-edge-v3.png';
import { HeroTitle, MagneticLink, LaboratoryLabel } from '../components/LabMotion';
import ProjectSections from '../components/ProjectSections.astro';
import { LabGridBackground } from '../components/LabEffects';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ccastillo.dev — El laboratorio de Jose Castillo</title>
    <meta name="description" content="El laboratorio abierto de Jose Castillo. Proyectos web, redes y automatización: ideas que terminan en código, desde Mazatlán." />
    <meta name="theme-color" content="#edf1f7" />
    <link rel="canonical" href="https://ccastillo.dev/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content="ccastillo.dev — Laboratorio de desarrollo" />
    <meta property="og:description" content="Proyectos web, redes y pequeñas herramientas. El laboratorio abierto de Jose Castillo, desde Mazatlán." />
    <meta property="og:url" content="https://ccastillo.dev/" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="ccastillo.dev, inicio"><span class="brand-full">ccastillo</span>.dev</a>
      <nav aria-label="Navegación principal">
        <a href="#proyectos"><span aria-hidden="true">[</span> Proyectos <span aria-hidden="true">]</span></a>
        <a href="#laboratorio"><span aria-hidden="true">[</span> Laboratorio <span aria-hidden="true">]</span></a>
        <a href="https://github.com/JCastilloPadilla"><span aria-hidden="true">[</span> GitHub ↗ <span aria-hidden="true">]</span></a>
      </nav>
    </header>

    <main id="contenido">
      <section class="hero" aria-labelledby="hero-title">
        <Image class="hero-art" src={workshop} alt="" format="webp" quality={85} loading="eager" fetchpriority="high" aria-hidden="true" />
        <div class="hero-inner wrap">
        <div class="hero-text">
        <p class="hero-location">Jose Castillo · Mazatlán, México</p>
        <HeroTitle client:load />
        <div class="hero-bottom">
          <div class="hero-copy">
            <p>Ideas que terminan en código. Proyectos web, redes y pequeñas herramientas que construyo para aprender y resolver cosas.</p>
          </div>
          <div class="hero-actions"><MagneticLink client:load className="button" href="#proyectos">Explorar proyectos <span aria-hidden="true">→</span></MagneticLink><MagneticLink client:load className="button button-outline" href="https://github.com/JCastilloPadilla">Ver el código <span aria-hidden="true">↗</span></MagneticLink></div>
        </div>
        </div>
        </div>
      </section>
      <div class="status-strip"><div class="wrap"><p><span class="status-dot" aria-hidden="true"></span> <LaboratoryLabel client:visible /></p><p>Web · Redes · Automatización</p><a href="https://ccastillo.me/">Mi portafolio personal ↗</a></div></div>

      <ProjectSections />
      <section id="laboratorio" class="about" aria-labelledby="about-title">
        <LabGridBackground client:visible />
        <div class="about-content wrap">
        <div class="section-heading reveal"><h2 id="about-title">El laboratorio</h2><span>Entorno de pruebas</span></div>
        <p class="about-summary">Un sitio para pruebas de todo tipo: desarrollo web, bases de datos, APIs, integraciones y automatizaciones.</p>
        </div>
      </section>
    </main>

    <footer id="contacto" class="footer" aria-labelledby="footer-title">
      <Image class="footer-art" src={footerCoast} alt="" format="webp" quality={85} loading="lazy" aria-hidden="true" />
      <div class="footer-content wrap">
        <div class="footer-header">
          <a class="footer-brand" href="/">ccastillo<span>.dev</span></a>
          <a class="footer-up" href="#contenido">Volver arriba <span aria-hidden="true">↑</span></a>
        </div>
        <div class="footer-grid">
          <div class="footer-main">
            <h2 id="footer-title">Seguimos<br />construyendo.</h2>
            <p class="footer-intro">¿Una idea, una pregunta o algo que quieras construir? Las buenas conversaciones también empiezan proyectos.</p>
            <a class="footer-email" href="mailto:joosec29@gmail.com">Hablemos <span aria-hidden="true">↗</span></a>
            <nav class="footer-nav" aria-label="Enlaces del footer">
              <div><h3>Explorar</h3><a href="#proyectos">Proyectos</a><a href="#laboratorio">El laboratorio</a><a href="https://ccastillo.me/">Portafolio <span aria-hidden="true">↗</span></a></div>
              <div><h3>Conectar</h3><a href="https://github.com/JCastilloPadilla">GitHub <span aria-hidden="true">↗</span></a><a href="mailto:joosec29@gmail.com">Correo <span aria-hidden="true">↗</span></a></div>
            </nav>
            <div class="footer-fineprint"><p>Desde Mazatlán, México.</p><span>© {year} Jose Castillo</span></div>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
